# ── LLM Provider Configuration ────────────────────────────────────────────────
# Any OpenAI-compatible provider works — just change the three vars below.

# Groq (default — fast, free tier, open-weight models)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.1-8b-instant

# Optional: fallback model tried if the primary model fails all retries
# LLM_FALLBACK_MODEL=llama-3.1-70b-versatile

# ── Other provider examples (uncomment to switch) ─────────────────────────────
# OpenRouter (access 100+ open-weight models)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=your_openrouter_api_key_here
# LLM_MODEL=meta-llama/llama-3.1-8b-instruct

# Local Ollama (no API key needed)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8000
